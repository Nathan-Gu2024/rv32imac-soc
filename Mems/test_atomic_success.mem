01000293  // addi x5, x0, 16    -> x5 = 0x00000010 (Memory address target)
02a00313  // addi x6, x0, 42    -> x6 = 42         (Data value to write)
1002a3af  // lr.w x7, (x5)      -> Load word from 0x10 into x7, set reservation
1862a42f  // sc.w x8, x6, (x5)  -> Write 42 to 0x10. Sets x8 = 0 (Success)
00000013  // nop
00000013  // nop
0002a503  // lw x10, 0(x5)