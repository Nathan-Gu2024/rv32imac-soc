# Build artifacts - regenerate with fpga/coremark/build.sh and the
# per-test build steps described in the README.
Testbenches/build_*/
Testbenches/sim
fpga/coremark/build/
fpga/coremark/build_sim/
fpga/tests/build_*/

# Chisel / Scala build artifacts - regenerate with:
#   cd chisel && scala-cli run src/MmAccel.scala
#
# scala-cli puts its cache next to the SOURCE file, i.e. chisel/src/.scala-build,
# so the chisel/.scala-build/ pattern never matched and ~4,000 lines of .class
# files were tracked and churned on every elaboration.
**/.scala-build/
chisel/generated/
chisel/out/
.bloop/
.metals/
.bsp/
# Accelerator simulation artifacts
Testbenches/*.vvp
Testbenches/sim_*
!Testbenches/sim_*.v

scripts/